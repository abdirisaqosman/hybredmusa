{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hybredmusa-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-10-01",
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hybredmusa-db",
      // Replaced with the real id from `wrangler d1 create hybredmusa-db` before deploying.
      "database_id": "local-dev-placeholder",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "API_VERSION": "0.1.0",
    "GIT_COMMIT": "dev"
  }
}
