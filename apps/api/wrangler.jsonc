{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hybredmusa-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-10-01",
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hybredmusa-db",
      "database_id": "7cb87200-7a59-4a45-a4bc-be2c18091746",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "API_VERSION": "0.1.0",
    "GIT_COMMIT": "dev"
  }
}
