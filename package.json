{
  "name": "hybredmusa",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/api",
    "apps/web",
    "packages/shared"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:api dev:web",
    "dev:api": "npm run dev -w @hybredmusa/api",
    "dev:web": "npm run dev -w @hybredmusa/web",
    "build": "npm run build -w @hybredmusa/shared && npm run build -w @hybredmusa/api && npm run build -w @hybredmusa/web",
    "test": "npm run test -w @hybredmusa/api",
    "db:generate": "npm run db:generate -w @hybredmusa/api",
    "db:migrate:local": "npm run db:migrate:local -w @hybredmusa/api",
    "db:migrate:remote": "npm run db:migrate:remote -w @hybredmusa/api",
    "deploy:api": "npm run deploy -w @hybredmusa/api",
    "deploy:web": "npm run deploy -w @hybredmusa/web",
    "deploy": "npm run deploy:api && npm run deploy:web",
    "admin:promote": "node scripts/admin-promote.mjs"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.2"
  }
}
